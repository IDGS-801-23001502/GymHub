    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "test:cov:total": "vitest run --config ./vitest.config.cov.ts --coverage",
    "prisma:generate": "prisma generate",
    "token:dev": "node scripts/token-dev.mjs",
    "claves:rotar": "node dist/cli/rotar-claves.js",
    "respaldo": "node scripts/respaldo.mjs",
    "postinstall": "prisma generate",
    "prebuild": "prisma generate",
    "db:pull:check": "prisma db pull --print",
    "usuario:password": "node scripts/usuario-password.mjs"
  },
  "dependencies": {
