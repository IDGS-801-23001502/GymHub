datasource db {
  provider = "mongodb"
  url      = env("MONGODB_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "../../node_modules/@prisma/mongodb-client"
}

model Log {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  action    String
  createdAt DateTime @default(now())
}