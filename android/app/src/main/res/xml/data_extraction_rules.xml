<?xml version="1.0" encoding="utf-8"?>
<!-- Las preferencias cifradas dependen de una llave del Keystore que no se respalda: no se copian -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
