# ==========================================
# GymHub Frontend - .gitignore
# ==========================================

# --- Dependencies & Compiled Output ---
node_modules/
dist/
dist-ssr/
build/

# --- TypeScript & Build Cache ---
*.tsbuildinfo
.tmp/
.temp/

# --- Environment Variables ---
.env
.env.*
!.env.example
*.local

# --- Logs ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Tests & Coverage ---
coverage/
.nyc_output/

# --- Operating System ---
.DS_Store
Thumbs.db
Desktop.ini

# --- IDEs & Editors ---
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
